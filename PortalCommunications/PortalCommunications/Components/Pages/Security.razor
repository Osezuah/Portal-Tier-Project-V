@page "/security"
@using System.Security.Claims

<PageTitle>Security Devices</PageTitle>

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-10">
            <div class="card shadow p-3 mb-5 rounded">
                <div class="card-header text-center">
                    <img src="images/portal logo.png" alt="Portal Logo" style="width: 150px;">
                    <h3 class="fw-bold mt-3">Security Devices</h3>
                </div>
                <div class="card-body">
                    @if (DeviceList?.Any() == true)
                    {
                        <table class="table table-striped table-hover">
                            <thead class="table-primary">
                                <tr>
                                    <th>Device(s)</th>
                                    <th>Location</th>
                                    <th>Status</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var device in DeviceList)
                                {
                                    <tr>
                                        <td>@device.Name</td>
                                        <td>@device.Location</td>
                                        <td>
                                            <div class="form-check form-switch">
                                                <input class="form-check-input" type="checkbox" id="device-@device.Name" checked="@device.Status" />
                                                <label class="form-check-label" for="device-@device.Name">
                                                    @(device.Status ? "On" : "Off")
                                                </label>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }
                    else
                    {
                        <div class="alert alert-info text-center" role="alert">
                            No devices connected.
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private List<SmartDevice> DeviceList = new()
    {
        new SmartDevice { Name = "Front Door Camera", Location = "Entrance", Status = true },
        new SmartDevice { Name = "Living Room Sensor", Location = "Living Room", Status = false },
        new SmartDevice { Name = "Garage Door Lock", Location = "Garage", Status = true },
        new SmartDevice { Name = "Backyard Camera", Location = "Backyard", Status = false }
    };

    private class SmartDevice
    {
        public string Name { get; set; } = string.Empty;
        public string Location { get; set; } = string.Empty;
        public bool Status { get; set; }
    }
}
