@page "/all-devices"
@using PortalCommunications.Services
@using PortalCommunicationsAPI.Models
@inject DeviceService DeviceService

<PageTitle>All Devices</PageTitle>

<div class="container text-center">
    <img src="images/portal logo.png" alt="Portal Logo" style="width: 150px;">
    <h3 class="display-5">
        Security Devices
    </h3>
    <small class="text-body-secondary">Monitor your security devices here.</small>
</div>

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="card-body">
            @if (devices?.Any() == true)
            {
                <table class="table table-striped table-hover">
                    <thead class="table-primary">
                        <tr>
                            <th>Device(s)</th>
                            <th>State</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var device in devices)
                        {
                            <tr>
                                <td>@device.Name</td>
                                <td>@device.State</td>
                                <td>
                                    <div class="form-check form-switch">
                                        <input class="form-check-input" type="checkbox" role="switch"
                                               checked="@IsDeviceOnline(device)" />
                                        <label class="form-check-label">@device.State</label>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
            else
            {
                <PlaceholderContainer Animation="PlaceholderAnimation.Glow">
                    <Placeholder Width="PlaceholderWidth.Col12" Size="PlaceholderSize.Large" Color="PlaceholderColor.Info"/>
                </PlaceholderContainer>
            }
        </div>
    </div>
</div>

@code {
    private List<Device> devices = new();

    protected override async Task OnInitializedAsync()
    {
        devices = await DeviceService.GetDevicesAsync();
    }

    private bool IsDeviceOnline(Device device)
    {
        return device.State == "Online"; // Return true if the device is "Online"
    }
}