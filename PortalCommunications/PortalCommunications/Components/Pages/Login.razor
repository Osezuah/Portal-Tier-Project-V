@page "/"
@rendermode InteractiveServer
@using PortalCommunications.Components.Layout
@layout EmptyLayout
@using Microsoft.AspNetCore.Components.Authorization
@using PortalCommunications.Components.Services
@using System.Security.Claims
@inject CustomAuthenticationService AuthService
@inject NavigationManager NavigationManager

<AuthorizeView>
    <Authorized>
        <p>Hello, @context.User.Identity?.Name!</p>
    </Authorized>
    <NotAuthorized>
        <p>You're not authorized.</p>
    </NotAuthorized>
</AuthorizeView>

<div class="container">
    <div class="row justify-content-center align-items-center vh-100">
        <div class="col-12 col-md-6 col-lg-4">
            <!-- Card Wrapper -->
            <div class="card shadow p-4 rounded">
                <div class="card-body text-center">
                    <!-- Responsive Image -->
                    <img src="../images/portal logo.png" alt="Portal Logo" class="img-fluid mb-3" style="max-width: 150px;">
                    <!-- Responsive Title -->
                    <h3 class="fw-bold mb-4">Welcome to Portal</h3>

                    <!-- Login Form -->
                    <form @onsubmit="SignIn">
                        <div class="mb-3">
                            <input @bind="userIdentifier" tabindex="userIdentifier" type="text" class="form-control" id="usernameInput" required placeholder="Enter Username">
                        </div>
                        <div class="mb-3">
                            <input tabindex="passwordIdentifier" type="password" class="form-control" id="passwordInput" placeholder="Not in Use...">
                        </div>
                        <div class="d-grid mb-3">
                            <button type="submit" class="btn btn-primary">Login</button>
                        </div>
                    </form>

                    <!-- OR Separator -->
                    <div class="mb-3">
                        <span class="text-muted">OR</span>
                    </div>

                    <!-- Register Button -->
                    <div class="d-grid">
                        <a class="btn btn-outline-primary" href="/registeruser">Register</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    public string userIdentifier = string.Empty;
    private void SignIn()
    {
        var identity = new ClaimsIdentity(new[]
        {
            new Claim(ClaimTypes.Name, userIdentifier),
        }, "Custom Authentication");

        var newUser = new ClaimsPrincipal(identity);
        AuthService.CurrentUser = newUser;

        // Redirect to /all-devices page
        NavigationManager.NavigateTo("/all-devices");
    }
}
