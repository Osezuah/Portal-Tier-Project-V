@page "/"
@rendermode InteractiveServer
@using PortalCommunications.Components.Layout
@*Custom layout file that removes the navigation bar from this page*@
@layout EmptyLayout 
@using Microsoft.AspNetCore.Components.Authorization
@using PortalCommunications.Components.Services
@using System.Security.Claims
@inject CustomAuthenticationService AuthService
@inject NavigationManager NavigationManager

<AuthorizeView>
    <Authorized>
        <p>Hello, @context.User.Identity?.Name!</p>
    </Authorized>
    <NotAuthorized>
        <p>You're not authorized.</p>
    </NotAuthorized>
</AuthorizeView>

<div class="container text-center">
    <div class="row justify-content-center">
        <div class="col-8">
            <!--Portal image goes here-->
            <div>
                <img style="width:150px" src="../images/portal logo.png" />
            </div>
            <!-- Adjust col size for the title width -->
            <h3 class="fw-bold">Welcome to Portal</h3>
        </div>
    </div>
</div>

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-6">
            <!-- Adjust col size for input width -->
            <form>
                <div class="mb-4">
                    <label for="usernameInput" class="form-label">Enter Username</label>
                    <input @bind="userIdentifier" tabindex="userIdentifier" type="text" class="form-control" id="usernameInput" required>
                </div>
@*                 <div class="mb-4">
                    <label for="passwordInput" class="form-label">Enter Password</label>
                    <input type="password" class="form-control" id="passwordInput" required>
                </div> *@
                <!-- Adjust col for button width -->
                 <button @onclick="SignIn" type="button" class="btn btn-primary small">Login</button>

                @* <a href="/registeruser" class="btn btn-primary small" >Register</a> *@

            </form>
        </div>
    </div>
</div>

@code {
    public string userIdentifier = string.Empty;
    public string hellomessage = string.Empty;
    private void SignIn()
    {
        var identity = new ClaimsIdentity(new[]
        {
        new Claim(ClaimTypes.Name, userIdentifier),
    }, "Custom Authentication");

        var newUser = new ClaimsPrincipal(identity);
        AuthService.CurrentUser = newUser;

        //redirect to /security page - Ehi changed it to all-devices page
        NavigationManager.NavigateTo("/all-devices");
    }
}
