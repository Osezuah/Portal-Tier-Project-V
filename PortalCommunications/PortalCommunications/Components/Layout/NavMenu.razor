@rendermode InteractiveServer

@using Microsoft.AspNetCore.Components.Authorization
@using PortalCommunications.Components.Services
@using System.Security.Claims
@inject CustomAuthenticationService AuthService
@inject NavigationManager NavigationManager

<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand" href="">Smart Home Portal</a> @*Navigation Bar Title*@
    </div>
</div>

<input type="checkbox" title="Navigation menu" class="navbar-toggler" />

<div class="nav-scrollable" onclick="document.querySelector('.navbar-toggler').click()">
    <nav class="flex-column">
        @*DELETE BRIAN'S HOME UI FROM NavMenu*@
        @* <div class="nav-item px-3">
            <NavLink class="nav-link" href="/home-page">
                <span class="bi bi-house-nav-menu" aria-hidden="true"></span> Home Page
            </NavLink>
        </div> *@

        <div class="nav-item px-3">  @*All Devices Link*@
            <NavLink class="nav-link" href="all-devices">
                <span class="bi bi-list-nested-nav-menu" aria-hidden="true"></span> All Devices
            </NavLink>
        </div>

        <div class="nav-item px-3">  @*Security Link*@
            <NavLink class="nav-link" href="security">
                <span class="bi bi-shield-lock-nav-menu" aria-hidden="true"></span> Security
            </NavLink>
        </div>

        <div class="nav-item px-3">  @*Account Link*@
            <NavLink class="nav-link" href="account">
                <span class="bi bi-person-nav-menu" aria-hidden="true"></span> Account
            </NavLink>
        </div>
        <div class="nav-item px-3">
            @*Logout*@
            <NavLink class="nav-link" style="cursor: pointer"  onclick="openModal()">
                <span class="bi bi-person-nav-menu" aria-hidden="true"></span> Logout
            </NavLink>
        </div>
        <div class="nav-item px-3">
            @*Account Link*@
            <NavLink class="nav-link" href="modals">
                <span class="bi bi-person-nav-menu" aria-hidden="true"></span> Modals(just examples)
            </NavLink>
        </div>
        


    </nav>
</div>

@*Logout pop-up confirmation message*@
<div class="modal" id="logoutModal">
    <div class="modal-dialog modal-dialog-centered" data-backdrop="static" data-keyboard="false">
        <div class="modal-content">
            <div class="modal-header">
                <strong class="modal-title"> WARNING!!!</strong> @*Title of modal*@
                @*dismiss button 'X'*@
                <button type="button" class="btn-close" onclick="closeModal()" aria-label="Close"></button>
            </div>

            <div class="modal-body">
                <h5>Are you sure you want to logout?</h5> @*Message in modal*@
            </div>

            <div class="modal-footer"> @*Confirmation buttons*@
                <a class="btn btn-danger" href="#" @onclick="Logout"> Yes</a>
                <button class="btn btn-primary" onclick="closeModal()"> Cancel</button>
            </div>
        </div>
    </div>
</div>

<script>
    function openModal() { @*Function that displays the modal window*@
        document.getElementById("logoutModal").style.display = "block";
    }

    function closeModal() { @*Function that closes the modal window*@
        document.getElementById("logoutModal").style.display = "none";
    }
</script>

@code{
    //logout function
    private void Logout()
    {
        //reset the auth service
        AuthService.CurrentUser = new ClaimsPrincipal(); //reset the user
        NavigationManager.NavigateTo("/");
    }
}


